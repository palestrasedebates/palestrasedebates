# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Produto
VITE_PRODUCT=palestrasedebates
VITE_APP_URL=https://palestrasedebates.com
VITE_APP_NAME=Palestras e Debates

# IA — usada SÓ na função serverless /api/ai. NUNCA com prefixo VITE_, nunca no cliente.
AI_PROVIDER=openai
AI_API_KEY=your-openai-key
# Modelo por-modo (família gpt-5, via Responses API). AI_MODEL é o fallback dos dois.
AI_MODEL=gpt-5-nano
AI_MODEL_PLAN=gpt-5-nano
AI_MODEL_CHAT=gpt-5-mini
